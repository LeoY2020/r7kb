{
  "name": "r7kb-teacher-studio",
  "version": "0.1.0",
  "private": true,
  "description": "r7kb 教师工作台：图形化编辑知识库、题库、图谱与资料库，并发布到 r7kb-web",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
